{
  "name": "@maps/native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start",
    "build": "expo export",
    "build:android": "expo run:android --variant release",
    "build:ios": "expo run:ios --configuration Release",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "lint": "expo lint",
    "check-types": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "emulator:list": "~/Library/Android/sdk/emulator/emulator -list-avds",
    "emulator:start": "~/Library/Android/sdk/emulator/emulator @Pixel_4_API_33 -no-snapshot-save &",
    "emulator:kill": "~/Library/Android/sdk/platform-tools/adb emu kill",
    "emulator:devices": "~/Library/Android/sdk/platform-tools/adb devices"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@maps/core": "workspace:*",
    "@maps/api-client": "workspace:*",
    "@maps/i18n": "workspace:*",
    "@maps/design-tokens": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.13",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.3.0",
    "expo-linking": "~7.1.5",
    "expo-location": "~18.1.0",
    "expo-router": "~5.1.1",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.9",
    "expo-web-browser": "~14.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.80.1",
    "react-native-gesture-handler": "~2.27.1",
    "react-native-reanimated": "~3.18.0",
    "react-native-safe-area-context": "5.5.2",
    "react-native-screens": "~4.12.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.15.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "@types/jest": "^29.5.14",
    "typescript": "~5.8.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^30.0.4",
    "jest-expo": "~53.0.0"
  },
  "private": true
}
