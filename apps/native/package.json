{
  "name": "@maps/native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start",
    "build": "expo export",
    "build:android": "expo run:android --variant release",
    "build:ios": "expo run:ios --configuration Release",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "lint": "expo lint",
    "check-types": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "emulator:list": "~/Library/Android/sdk/emulator/emulator -list-avds",
    "emulator:start": "~/Library/Android/sdk/emulator/emulator @Pixel_4_API_33 -no-snapshot-save &",
    "emulator:kill": "~/Library/Android/sdk/platform-tools/adb emu kill",
    "emulator:devices": "~/Library/Android/sdk/platform-tools/adb devices"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@maps/core": "workspace:*",
    "@maps/api-client": "workspace:*",
    "@maps/i18n": "workspace:*",
    "@maps/design-tokens": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~54.0.22",
    "expo-blur": "~15.0.7",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.14",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.82.1",
    "react-native-gesture-handler": "~2.29.1",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.18.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.2",
    "@types/jest": "^29.5.14",
    "typescript": "~5.9.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^30.2.0",
    "jest-expo": "~54.0.13"
  },
  "private": true
}
