{
  "name": "@maps/native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start",
    "build": "expo export",
    "build:android": "expo run:android --variant release",
    "build:ios": "expo run:ios --configuration Release",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "lint": "expo lint",
    "check-types": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "emulator:list": "~/Library/Android/sdk/emulator/emulator -list-avds",
    "emulator:start": "~/Library/Android/sdk/emulator/emulator @Pixel_4_API_33 -no-snapshot-save &",
    "emulator:kill": "~/Library/Android/sdk/platform-tools/adb emu kill",
    "emulator:devices": "~/Library/Android/sdk/platform-tools/adb devices"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@maps/api-client": "workspace:*",
    "@maps/core": "workspace:*",
    "@maps/design-tokens": "workspace:*",
    "@maps/i18n": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~55.0.8",
    "expo-blur": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-linking": "~55.0.8",
    "expo-location": "~55.1.4",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "~4.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.14",
    "@types/jest": "^29.5.14",
    "typescript": "~5.9.3",
    "eslint": "^10.1.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^30.3.0",
    "jest-expo": "~55.0.11"
  },
  "private": true
}
