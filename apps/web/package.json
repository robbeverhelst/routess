	"version": "1.34.0",
	"type": "module",
	"scripts": {
		"dev": "vite --port ${WEB_PORT:-5173}",
		"build": "vite build",
		"lint": "biome check .",
		"check-types": "bunx --bun tsr generate && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit",
