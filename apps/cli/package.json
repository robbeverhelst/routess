{
	"name": "routess",
	"version": "0.1.0",
	"private": false,
	"description": "Command-line interface for Routess, the route-planning product for cyclists, runners, and hikers.",
	"homepage": "https://github.com/robbeverhelst/routess/tree/main/apps/cli#readme",
	"bugs": {
		"url": "https://github.com/robbeverhelst/routess/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/robbeverhelst/routess.git",
		"directory": "apps/cli"
	},
	"bin": {
		"routess": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target node --format esm",
		"prepack": "bun run build",
		"lint": "biome check .",
		"check-types": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {},
	"devDependencies": {
		"@routess/core": "workspace:*",
		"@types/node": "^26.0.0",
		"commander": "^15.0.0",
		"typescript": "~7.0.0"
	}
}
