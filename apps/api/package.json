{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "nest build",
		"format": "biome format --write src/ test/",
		"start": "nest start",
		"predev": "mikro-orm schema:update --run || true",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "bun dist/src/start-prod.js",
		"lint": "biome check --fix src/ test/",
		"lint:check": "biome check src/ test/",
		"test": "bun test --timeout 30000 --max-concurrency 1",
		"test:unit": "bun test test/unit/ src/",
		"test:integration": "bun test --timeout 30000 --max-concurrency 1 test/integration/",
		"test:e2e": "bun test --timeout 30000 --max-concurrency 1 test/e2e/",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"check-types": "tsc --noEmit",
		"ci": "bun run check-types && bun run lint:check && bun run build && bun run test",
		"clean": "rimraf dist coverage .nest node_modules/.cache",
		"docker:build": "docker build -f Dockerfile -t routess-api ../..",
		"db:up": "cd ../.. && docker-compose up -d postgres",
		"db:down": "cd ../.. && docker-compose down",
		"db:migration:create": "mikro-orm migration:create",
		"db:migration:up": "mikro-orm migration:up",
		"db:schema:create": "mikro-orm schema:create",
		"openapi:generate": "bun src/openapi.ts"
	},
	"dependencies": {
		"@mikro-orm/cli": "^6.4.16",
		"@mikro-orm/core": "^6.4.16",
		"@mikro-orm/migrations": "^6.4.16",
		"@mikro-orm/nestjs": "^6.1.1",
		"@mikro-orm/postgresql": "^6.4.16",
		"@nestjs/common": "^11.1.3",
		"@nestjs/core": "^11.1.3",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/mapped-types": "^2.0.7",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.3",
		"@nestjs/schedule": "^6.0.0",
		"@nestjs/swagger": "^11.2.0",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.4.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/auto-instrumentations-node": "^0.72.0",
		"@opentelemetry/exporter-prometheus": "^0.214.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
		"@opentelemetry/sdk-metrics": "^2.0.1",
		"@opentelemetry/sdk-node": "^0.214.0",
		"bcryptjs": "^3.0.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.0",
		"compression": "^1.8.0",
		"dotenv": "^16.5.0",
		"google-auth-library": "^10.1.0",
		"helmet": "^8.1.0",
		"nestjs-pino": "^4.4.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.16.2",
		"pino": "^9.7.0",
		"pino-http": "^10.5.0",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.0.1",
		"rxjs": "^7.2.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.7",
		"@nestjs/schematics": "^11.0.5",
		"@nestjs/testing": "^11.1.3",
		"@types/bcryptjs": "^3.0.0",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.3",
		"@types/jest": "30.0.0",
		"@types/node": "^24.0.1",
		"@types/passport-jwt": "^4.0.1",
		"@types/pg": "^8.15.4",
		"@types/supertest": "^6.0.3",
		"@types/uuid": "^10.0.0",
		"jest": "30.3.0",
		"source-map-support": "^0.5.20",
		"supertest": "^7.1.1",
		"ts-jest": "29.4.6",
		"ts-loader": "^9.2.3",
		"ts-node": "^10.0.0",
		"tsconfig-paths": "4.2.0",
		"typescript": "~6.0.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": "(test/.*/.*\\.(spec|e2e\\.spec)\\.ts$|src/.*\\.spec\\.ts$)",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.test.json"
				}
			]
		},
		"collectCoverageFrom": [
			"src/**/*.(t|j)s",
			"!src/**/*.spec.ts",
			"!src/**/*.e2e-spec.ts",
			"!src/main.ts",
			"!src/**/index.ts"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"coverageReporters": [
			"text",
			"lcov",
			"html"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"/test/",
			"/dist/"
		],
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/src/$1"
		},
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		]
	}
}
