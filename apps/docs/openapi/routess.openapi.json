		"/routes/{id}": {
			"get": {
				"description": "Retrieves a specific route by ID for the authenticated user",
				"operationId": "RoutesController_findOne",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"description": "Route ID",
						"schema": {
							"type": "number"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Route retrieved successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RouteResponseDto"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"404": {
						"description": "Route not found"
					}
				},
				"security": [
					{
						"JWT-auth": []
					}
				],
				"summary": "Get route by ID",
				"tags": ["routes"]
			},
			"patch": {
				"description": "Updates a specific route for the authenticated user",
				"operationId": "RoutesController_update",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"description": "Route ID",
						"schema": {
							"type": "number"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateRouteDto"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Route updated successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RouteResponseDto"
								}
							}
						}
					},
					"400": {
						"description": "Invalid route data"
					},
					"401": {
						"description": "Unauthorized"
					},
					"404": {
						"description": "Route not found"
					}
				},
				"security": [
					{
						"JWT-auth": []
					}
				],
				"summary": "Update route",
				"tags": ["routes"]
			},
			"delete": {
				"description": "Deletes a specific route for the authenticated user",
				"operationId": "RoutesController_remove",
				"parameters": [
					{
						"name": "id",
						"required": true,
						"in": "path",
						"description": "Route ID",
						"schema": {
							"type": "number"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Route deleted successfully",
						"content": {
							"application/json": {
								"schema": {
									"example": {
										"success": true,
										"message": "Route deleted successfully"
									}
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"404": {
						"description": "Route not found"
					}
				},
				"security": [
					{
						"JWT-auth": []
					}
				],
				"summary": "Delete route",
				"tags": ["routes"]
			}
		},
