		{
			"url": "http://localhost:3000",
			"description": "Local development"
		},
		{
			"url": "https://routess-api.robbeverhelst.com",
			"description": "Production"
		},
		{
			"url": "https://api.routess.com",
			"description": "Future canonical domain"
		}
	],
	"components": {
		"securitySchemes": {
			"JWT-auth": {
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"type": "http",
				"in": "header"
			}
		},
		"schemas": {
			"UserStatisticsDto": {
				"type": "object",
				"properties": {
					"totalRoutes": {
						"type": "number",
						"example": 12
					},
					"totalDistance": {
						"type": "number",
						"example": 42350,
						"description": "Total distance in meters"
					}
				},
				"required": ["totalRoutes", "totalDistance"]
			},
			"UserProfileDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number",
						"example": 1
					},
					"email": {
						"type": "string",
						"example": "user@example.com"
					},
					"name": {
						"type": "string",
						"example": "Jane Doe"
					},
					"avatar": {
						"type": "string",
						"example": "https://example.com/avatar.jpg"
					},
					"isEmailVerified": {
						"type": "boolean",
						"example": true
					},
					"statistics": {
						"$ref": "#/components/schemas/UserStatisticsDto"
					}
				},
				"required": ["id", "email", "name", "isEmailVerified", "statistics"]
			},
			"UpdateCurrentUserDto": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"example": "Jane Doe"
					},
					"avatar": {
						"type": "string",
						"example": "https://example.com/avatar.jpg"
					}
				}
			},
			"GoogleAuthDto": {
				"type": "object",
				"properties": {
					"credential": {
						"type": "string",
						"description": "Google OAuth2 credential token",
						"example": "eyJhbGciOiJSUzI1NiIsImtpZCI6IjdkYzAyYjg5..."
					}
				},
				"required": ["credential"]
			},
			"UserResponseDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number",
						"example": 1
					},
					"email": {
						"type": "string",
						"example": "user@example.com"
					},
					"name": {
						"type": "string",
						"example": "Jane Doe"
					},
					"avatar": {
						"type": "string",
						"example": "https://example.com/avatar.jpg"
					},
					"isEmailVerified": {
						"type": "boolean",
						"example": true
					}
				},
				"required": ["id", "email", "name", "isEmailVerified"]
			},
			"AuthResponseDto": {
				"type": "object",
				"properties": {
					"accessToken": {
						"type": "string",
						"description": "JWT access token for authentication",
						"example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
					},
					"user": {
						"description": "Authenticated user",
						"allOf": [
							{
								"$ref": "#/components/schemas/UserResponseDto"
							}
						]
					}
				},
				"required": ["accessToken", "user"]
			},
			"LogoutResponseDto": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean",
						"example": true
					}
				},
				"required": ["success"]
			},
			"WaypointDto": {
				"type": "object",
				"properties": {
					"lat": {
						"type": "number",
						"description": "Latitude coordinate of the waypoint",
						"example": 40.7128
					},
