	"info": {
		"title": "Routess API",
		"description": "API for route management and mapping functionality",
		"version": "dev",
		"contact": {}
	},
	"tags": [
		{
			"name": "auth",
			"description": "Authentication endpoints"
		},
		{
			"name": "routes",
			"description": "Route management"
		},
		{
			"name": "users",
			"description": "User profile management"
		},
		{
			"name": "app",
