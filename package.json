{
  "name": "maps-monorepo",
  "private": true,
  "version": "1.38.6",
  "type": "module",
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "docker:build": "turbo run docker:build",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t maps-web .",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t maps-api .",
    "infra:preview": "turbo run infra:preview",
    "infra:deploy": "turbo run infra:deploy",
    "infra:refresh": "turbo run infra:refresh",
    "infra:destroy": "turbo run infra:destroy"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "jest": "^29.7.0",
    "semantic-release": "^24.2.4",
    "ts-jest": "^29.3.4",
    "turbo": "^2.5.3",
    "typescript": "~5.8.3"
  }
}
