{
  "name": "maps-monorepo",
  "private": true,
  "version": "1.95.9",
  "type": "module",
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker-compose up -d postgres && (docker-compose up -d pgadmin || true) && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "(docker-compose up -d postgres || docker start maps-postgres || true) && bun run format && bun run lint && bun run build && bun run check-types && bun run test",
    "clean": "pkill -f 'esbuild' || true && killall -9 turbo node || true && turbo daemon stop || true && rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo /tmp/esbuild* apps/native/dist apps/native/android/build apps/native/android/.gradle apps/native/ios/build apps/native/.expo && bun install",
    "docker:build": "turbo run docker:build",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t maps-web .",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t maps-api .",
    "infra:preview": "turbo run infra:preview",
    "infra:deploy": "turbo run infra:deploy",
    "infra:refresh": "turbo run infra:refresh",
    "infra:destroy": "turbo run infra:destroy",
    "native:dev": "turbo run dev --filter=@maps/native",
    "native:android": "turbo run android --filter=@maps/native",
    "native:ios": "turbo run ios --filter=@maps/native",
    "native:prebuild": "turbo run prebuild --filter=@maps/native",
    "native:prebuild:clean": "turbo run prebuild:clean --filter=@maps/native",
    "native:build:android": "turbo run build:android --filter=@maps/native",
    "native:build:ios": "turbo run build:ios --filter=@maps/native",
    "ls": "node -e \"const pkg = require('./package.json'); console.log('\\n📋 Available Scripts:\\n'); Object.entries(pkg.scripts).forEach(([name, cmd]) => console.log('  ' + name.padEnd(25) + ' ' + cmd)); console.log('\\n💡 Usage: bun run <script-name>\\n');\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.17.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@tanstack/react-router-devtools": "^1.121.34",
    "@types/node": "^24.0.1",
    "eslint": "^9.17.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^16.4.0",
    "jiti": "^2.4.2",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.4",
    "tsx": "^4.19.2",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.2"
  },
  "overrides": {
    "brace-expansion": "^2.0.1"
  },
  "dependencies": {
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.6",
    "@opentelemetry/exporter-prometheus": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/instrumentation-http": "^0.205.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.52.2",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@types/compression": "^1.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  }
}
