{
	"name": "routess-monorepo",
	"private": true,
	"version": "1.166.0",
	"type": "module",
	"packageManager": "bun@1.3.13",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun ./scripts/dev.ts",
		"build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
		"lint": "biome check .",
		"check-types": "bun run --filter '*' check-types",
		"test": "bun run --filter '*' test",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"ci": "docker compose -f docker/compose.yaml --project-directory . up -d postgres && bun run format:check && bun run lint && bun run check-types && bun run build && bun run test",
		"clean": "bun ./scripts/clean.ts",
		"build:images": "cd docker && docker buildx bake --allow=fs.read=..",
		"docs:generate-api": "bun run --filter './apps/api' openapi:generate && bun run --filter './apps/docs' openapi:generate",
		"docs:sync-translations": "bun run --filter './apps/docs' guide:sync-translations"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@semantic-release/commit-analyzer": "^13.0.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.0",
		"@semantic-release/npm": "^13.0.0",
		"@semantic-release/release-notes-generator": "^14.0.1",
		"@types/node": "^26.0.0",
		"landing": "workspace:*",
		"playwright": "^1.59.1",
		"semantic-release": "^25.0.0",
		"typescript": "~6.0.0"
	},
	"overrides": {
		"ajv": "^8.18.0",
		"brace-expansion": "^5.0.0",
		"postcss": "^8.5.10"
	},
	"release": {
		"branches": [
			"main"
		],
		"tagFormat": "${version}",
		"plugins": [
			[
				"@semantic-release/commit-analyzer",
				{
					"preset": "angular",
					"releaseRules": [
						{
							"type": "refactor",
							"release": "patch"
						},
						{
							"type": "perf",
							"release": "patch"
						}
					],
					"parserOpts": {
						"noteKeywords": [
							"BREAKING CHANGE",
							"BREAKING CHANGES"
						]
					}
				}
			],
			[
				"@semantic-release/release-notes-generator",
				{
					"preset": "angular",
					"parserOpts": {
						"noteKeywords": [
							"BREAKING CHANGE",
							"BREAKING CHANGES"
						]
					},
					"writerOpts": {
						"commitsSort": [
							"subject",
							"scope"
						]
					}
				}
			],
			[
				"@semantic-release/npm",
				{
					"npmPublish": false
				}
			],
			[
				"@semantic-release/github",
				{
					"successComment": false,
					"failComment": false
				}
			],
			[
				"@semantic-release/git",
				{
					"assets": [
						"package.json"
					],
					"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
				}
			]
		]
	}
}
