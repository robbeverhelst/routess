{
  "name": "maps-monorepo",
  "private": true,
  "version": "1.54.0",
  "type": "module",
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker-compose up -d postgres && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "bun run format && bun run lint && bun run build && bun run check-types",
    "clean": "turbo run clean && rm -rf node_modules/.cache && rm -rf .turbo",
    "docker:build": "turbo run docker:build",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t maps-web .",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t maps-api .",
    "infra:preview": "turbo run infra:preview",
    "infra:deploy": "turbo run infra:deploy",
    "infra:refresh": "turbo run infra:refresh",
    "infra:destroy": "turbo run infra:destroy"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.17.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/node": "^24.0.1",
    "eslint": "^9.17.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.4",
    "tsx": "^4.19.2",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.18.2"
  },
  "overrides": {
    "brace-expansion": "^2.0.1"
  }
}
