{
	"name": "routess-monorepo",
	"private": true,
	"version": "1.175.0",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun ./scripts/dev.ts",
		"build": "bun run --filter './packages/*' build && bun run --filter './apps/*' build",
		"lint": "biome check .",
		"check:bun-native": "bun scripts/bun-native-check.ts",
		"lint:fix": "biome check --write .",
		"check-types": "bun run --filter '*' check-types",
		"check": "bun run lint && bun run check-types",
		"test": "bun run --filter '*' test",
		"test:e2e": "bun run --filter './apps/web' test:e2e",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"ci": "docker compose -f docker/compose.yaml --project-directory . up -d postgres && bun run format:check && bun run lint && bun run check:bun-native && bun run check-types && bun run build && bun run test",
		"clean": "bun ./scripts/clean.ts",
		"build:images": "cd docker && docker buildx bake --allow=fs.read=..",
		"docs:generate-api": "bun run --filter './apps/api' openapi:generate && bun run --filter './apps/docs' openapi:generate",
		"docs:sync-translations": "bun run --filter './apps/docs' guide:sync-translations"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@semantic-release/commit-analyzer": "^13.0.0",
		"@semantic-release/git": "^11.0.0",
		"@semantic-release/github": "^12.0.0",
		"@semantic-release/release-notes-generator": "^14.0.1",
		"@types/node": "^26.0.0",
		"landing": "workspace:*",
		"@playwright/test": "1.64.1",
		"playwright": "^1.59.1",
		"semantic-release": "^25.0.0",
		"typescript": "~7.0.0"
	},
	"overrides": {
		"ajv": "^8.18.0",
		"brace-expansion": "^5.0.0",
		"postcss": "^8.5.10"
	},
	"dependencies": {
		"@tanstack/router-cli": "^1.167.24"
	}
}
