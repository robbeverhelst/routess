	"description": "Routess API operational overview. Pairs with ADR-0014 (Prometheus owns operational metrics; admin UI links here for ops dashboards).",
	"editable": true,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 1,
	"liveNow": false,
	"panels": [
		{
			"type": "row",
			"title": "HTTP",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
			"id": 100,
			"collapsed": false,
			"panels": []
		},
		{
			"type": "timeseries",
			"title": "Request rate by status",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
			"id": 1,
			"fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
			"options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
			"targets": [
				{
					"expr": "sum by (status_code) (rate(http_requests_total[$__rate_interval]))",
					"legendFormat": "{{status_code}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "p95 request latency",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
			"id": 2,
			"fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
			"options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_ms_bucket[$__rate_interval])))",
					"legendFormat": "{{route}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Error rate",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
			"id": 3,
			"fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
			"targets": [
				{
					"expr": "sum by (status_code) (rate(http_request_errors_total[$__rate_interval]))",
					"legendFormat": "{{status_code}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "stat",
			"title": "Active users",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
			"id": 4,
			"fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } }, "overrides": [] },
			"targets": [{ "expr": "active_users", "refId": "A" }]
		},
		{
			"type": "stat",
			"title": "Total users",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
			"id": 5,
			"fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
			"targets": [{ "expr": "user_registrations_total", "refId": "A" }]
		},
		{
			"type": "row",
			"title": "Auth",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
			"id": 200,
			"collapsed": false,
			"panels": []
		},
		{
			"type": "timeseries",
			"title": "Login attempts by result",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
			"id": 6,
			"fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
			"targets": [
				{
					"expr": "sum by (result) (rate(auth_login_total[$__rate_interval]))",
					"legendFormat": "{{result}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Sessions revoked by reason",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
			"id": 7,
			"fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
			"targets": [
				{
					"expr": "sum by (reason) (rate(auth_session_revoked_total[$__rate_interval]))",
					"legendFormat": "{{reason}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "row",
			"title": "Database & external",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
			"id": 300,
			"collapsed": false,
			"panels": []
		},
		{
			"type": "timeseries",
			"title": "p95 DB query duration by operation",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
			"id": 8,
			"fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(db_query_duration_ms_bucket[$__rate_interval])))",
					"legendFormat": "{{operation}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "p95 external request duration",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
			"id": 9,
			"fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
			"targets": [
				{
					"expr": "histogram_quantile(0.95, sum by (le, provider) (rate(external_request_duration_ms_bucket[$__rate_interval])))",
					"legendFormat": "{{provider}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "row",
			"title": "Business",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
			"id": 400,
			"collapsed": false,
			"panels": []
		},
		{
			"type": "timeseries",
			"title": "Routes created vs deleted (rate)",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
			"id": 10,
			"fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
			"targets": [
				{ "expr": "rate(routes_created_total[$__rate_interval])", "legendFormat": "created", "refId": "A" },
				{ "expr": "rate(routes_deleted_total[$__rate_interval])", "legendFormat": "deleted", "refId": "B" }
			]
		},
		{
			"type": "timeseries",
			"title": "User registrations (rate)",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
			"id": 11,
			"fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
			"targets": [
				{
					"expr": "sum by (type) (rate(user_registrations_total[$__rate_interval]))",
					"legendFormat": "{{type}}",
					"refId": "A"
				}
			]
		},
		{
			"type": "row",
			"title": "Runtime",
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
			"id": 500,
			"collapsed": false,
			"panels": []
		},
		{
			"type": "timeseries",
			"title": "Event loop lag (p95)",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
			"id": 12,
			"fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
			"targets": [
				{
					"expr": "nodejs_eventloop_lag_p95_seconds * 1000",
					"legendFormat": "p95",
					"refId": "A"
				}
			]
		},
		{
			"type": "timeseries",
			"title": "Heap usage",
			"datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
			"id": 13,
			"fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
			"targets": [
				{ "expr": "nodejs_heap_size_used_bytes", "legendFormat": "used", "refId": "A" },
				{ "expr": "nodejs_heap_size_total_bytes", "legendFormat": "total", "refId": "B" }
			]
		}
	],
