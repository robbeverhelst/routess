# =============================================================================
# SHARED ENVIRONMENT VARIABLES
# =============================================================================
# This file contains all environment variables for the entire monorepo
# Copy this to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
PGADMIN_PORT=5050
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=routess_db

# =============================================================================
# API CONFIGURATION
# =============================================================================
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-for-development-only-change-in-production-make-it-very-long-and-random
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allowlist when the same frontend is served on multiple domains.
# FRONTEND_URLS takes precedence over FRONTEND_URL when both are set.
# FRONTEND_URLS=http://localhost:5173,https://routess.com,https://routess.be

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# =============================================================================
# WEB APP CONFIGURATION
# =============================================================================
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here
# Stadia Maps API key. Powers the Valhalla trace_attributes call used for the
# planner's surface breakdown. Free tier at https://stadiamaps.com. Falls back
# to the public FOSSGIS Valhalla instance when unset (often unreachable).
VITE_STADIA_API_KEY=your-stadia-api-key-here
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=dev

# Umami analytics. Leave empty to disable.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=

# =============================================================================
# PRODUCTION OVERRIDES (for reference)
# =============================================================================
# NODE_ENV=production
# FRONTEND_URL=https://routess.robbeverhelst.com
# VITE_APP_URL=https://routess.robbeverhelst.com
# VITE_API_URL=https://routess-api.robbeverhelst.com
