# Routess monorepo environment template.
# Copy to .env and replace placeholder values.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=routess_db

# --- pgAdmin (local docker compose only) ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@routess.dev
PGADMIN_PASSWORD=admin123

# --- App ports (bun dev auto-picks the next free port if taken) ---
PORT=3000
DOCS_PORT=3001
WEB_PORT=5173

# --- API ---
NODE_ENV=development
# Base URL of the Valhalla routing service. In production this is the
# cluster-internal Service (http://valhalla.valhalla.svc.cluster.local:8002).
# Leave empty to disable the trace-attributes proxy in local dev.
VALHALLA_URL=
# TileJSON URL of the node-network tiles served by go-pmtiles (ADR 0033/0037),
# e.g. https://tiles.routess.com/nodes.json. The generation pipeline derives
# knooppunt anchor pools from it. Leave empty to disable knooppunt mode.
NODE_TILES_URL=
JWT_SECRET=change-me-to-a-long-random-string
# Salt for pseudonymising user IDs in product analytics events. Long random
# string; do not commit. See ADR-0020.
ANALYTICS_SALT=change-me-to-a-long-random-analytics-salt
# Server-side pepper for HMAC-SHA-256 hashing of personal access tokens.
# Long random string; do not commit. Rotating it invalidates every existing
# PAT in the database. See ADR-0022.
PAT_PEPPER=change-me-to-a-long-random-pat-pepper
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allowlist; takes precedence over FRONTEND_URL.
# FRONTEND_URLS=http://localhost:5173,https://routess.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# --- Email (Resend) ---
# Required for the email+password signup verification and password reset
# flows (#134). Leave RESEND_API_KEY empty in dev and the EmailService falls
# back to logging the verification URL to API stdout (look for "[email:console]").
# When set, the FROM address must be from a domain you've verified in the
# Resend dashboard, OR use Resend's "onboarding@resend.dev" sender for testing
# (only delivers to the email tied to your Resend account).
RESEND_API_KEY=
EMAIL_FROM=Routess <noreply@routess.app>

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173
# Origin serving the canonical public route page (landing host, e.g. https://routess.com).
# Leave empty to fall back to the app origin.
VITE_PUBLIC_ROUTE_BASE_URL=
VITE_APP_VERSION=dev
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here

# --- Landing (Next, read server-side at request time) ---
# Public token for the live mini-planner map on the landing page. Injected at
# runtime (never baked into the image); without it the section falls back to
# a baked static preview image.
MAPBOX_PUBLIC_TOKEN=your-mapbox-access-token-here

# --- Umami analytics (optional, leave empty to disable) ---
# Web app (Vite) reads the VITE_-prefixed names; landing + docs (Next, server-side)
# read the plain names. Use the same Umami URL + one shared website ID for all.
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
UMAMI_URL=
UMAMI_WEBSITE_ID=

# --- Sentry / GlitchTip error reporting (optional, leave empty to disable) ---
# Public DSN from your GlitchTip project. Telemetry init no-ops if empty.
VITE_SENTRY_DSN=
# Environment tag attached to every event: production | staging | preview ...
VITE_SENTRY_ENVIRONMENT=
# Performance trace sample rate, 0..1. 0.1 = 10% of sessions sampled.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Structured logs (Sentry logs API), opt-in.
VITE_SENTRY_LOGS_ENABLED=false
# Verbose SDK console output, only useful in staging when diagnosing init.
VITE_SENTRY_DEBUG=false
# Build-time secret for uploading source maps to GlitchTip during CI image build.
# NEVER set at runtime; passed to docker buildx as a BuildKit secret.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=routess
# SENTRY_URL=https://glitchtip.example.com
