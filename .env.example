# =============================================================================
# SHARED ENVIRONMENT VARIABLES
# =============================================================================
# This file contains all environment variables for the entire monorepo
# Copy this to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
PGADMIN_PORT=5050
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=routess_db

# =============================================================================
# API CONFIGURATION
# =============================================================================
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-for-development-only-change-in-production-make-it-very-long-and-random
FRONTEND_URL=http://localhost:5173

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# =============================================================================
# WEB APP CONFIGURATION
# =============================================================================
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=dev

# =============================================================================
# PRODUCTION OVERRIDES (for reference)
# =============================================================================
# NODE_ENV=production
# FRONTEND_URL=https://routess.robbeverhelst.com
# VITE_APP_URL=https://routess.robbeverhelst.com
# VITE_API_URL=https://routess-api.robbeverhelst.com
