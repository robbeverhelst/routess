# Routess monorepo environment template.
# Copy to .env and replace placeholder values.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=routess_db

# --- pgAdmin (local docker compose only) ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@routess.dev
PGADMIN_PASSWORD=admin123

# --- App ports (bun dev auto-picks the next free port if taken) ---
PORT=3000
DOCS_PORT=3001
WEB_PORT=5173

# --- API ---
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Salt for pseudonymising user IDs in product analytics events. Long random
# string; do not commit. See ADR-0020.
ANALYTICS_SALT=change-me-to-a-long-random-analytics-salt
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allowlist; takes precedence over FRONTEND_URL.
# FRONTEND_URLS=http://localhost:5173,https://routess.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# --- Web (Vite) ---
VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=dev
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here
# Stadia Maps API key powers Valhalla trace_attributes for surface breakdowns.
# Free tier at https://stadiamaps.com. Falls back to public FOSSGIS Valhalla when unset.
VITE_STADIA_API_KEY=your-stadia-api-key-here

# --- Umami analytics (optional, leave empty to disable) ---
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
