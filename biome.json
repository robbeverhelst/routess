{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": true
			},
			"complexity": {
				"recommended": true,
				"noUselessFragments": "error"
			},
			"correctness": {
				"recommended": true,
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"performance": {
				"recommended": true,
				"noAccumulatingSpread": "error"
			},
			"security": {
				"recommended": true
			},
			"style": {
				"recommended": true,
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useConst": "error",
				"useTemplate": "error"
			},
			"suspicious": {
				"recommended": true,
				"noExplicitAny": "error",
				"noConsole": "error",
				"noDebugger": "error",
				"noEmptyBlockStatements": "error"
			},
			"nursery": {
				"recommended": true
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/api/**"],
			"javascript": {
				"parser": {
					"unsafeParameterDecoratorsEnabled": true
				}
			},
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedFunctionParameters": "off"
					},
					"style": {
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": [
				"scripts/**",
				"**/jest.setup.ts",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/test/**",
				"**/__tests__/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noConsole": "off",
						"noEmptyBlockStatements": "off"
					}
				}
			}
		},
		{
			"includes": ["**/public/sw.js", "**/public/sw.*.js"],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyBlockStatements": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/lib/logger.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/coverage",
			"!**/bin",
			"!**/build",
			"!**/bun.lockb",
			"!**/routeTree.gen.ts",
			"!.agents",
			"!.claude",
			"!skills-lock.json"
		]
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	}
}
