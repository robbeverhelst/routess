{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "group:allNonMajor", ":automergeMinor", "helpers:pinGitHubActionDigests"],
	"schedule": ["every weekday"],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 5am on monday"]
	},
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"]
	},
	"packageRules": [
		{
			"description": "@nestjs/cli needs the TypeScript compiler API, which TypeScript 7 does not ship yet; keep apps/api on TypeScript 6 until NestJS supports 7.",
			"matchFileNames": ["apps/api/package.json"],
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<7"
		}
	]
}
