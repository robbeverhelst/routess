{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "group:allNonMajor", ":automergeMinor", "helpers:pinGitHubActionDigests"],
	"schedule": ["every weekday"],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 5am on monday"]
	},
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"]
	}
}
