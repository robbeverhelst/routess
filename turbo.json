{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "bin/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "docker:build": {
      "dependsOn": ["^build"]
    },
    "infra:preview": {
      "cache": false,
      "dependsOn": ["@maps/infra#build"]
    },
    "infra:deploy": {
      "cache": false,
      "dependsOn": ["@maps/infra#build"]
    },
    "infra:refresh": {
      "cache": false,
      "dependsOn": ["@maps/infra#build"]
    },
    "infra:destroy": {
      "cache": false,
      "dependsOn": ["@maps/infra#build"]
    }
  }
} 