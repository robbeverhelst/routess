# Build image for the monthly node-network tile job (ADR 0033).
# Bundles the OSM toolchain: osmium (filter), GDAL (OSM->GeoJSON), tippecanoe
# (vector tiles), bun (transform), awscli (upload). Run via scripts/node-tiles.

# tippecanoe is not packaged for Debian and has no upstream image, so build it
# from source and copy the binaries into the runtime stage.
FROM debian:bookworm-slim AS tippecanoe
ARG TIPPECANOE_VERSION=2.79.0
RUN apt-get update && apt-get install -y --no-install-recommends \
		git build-essential libsqlite3-dev zlib1g-dev ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${TIPPECANOE_VERSION}" https://github.com/felt/tippecanoe.git /src \
	&& make -C /src -j"$(nproc)" \
	&& make -C /src install PREFIX=/usr/local

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
		ca-certificates curl \
		osmium-tool gdal-bin awscli \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=tippecanoe /usr/local/bin/tippecanoe /usr/local/bin/tippecanoe
COPY --from=tippecanoe /usr/local/bin/tile-join /usr/local/bin/tile-join

# bun runs the GeoJSON transform. Copy the pinned binary from the official
# image onto the global PATH so a non-root runtime user can execute it.
COPY --from=oven/bun:1.4.4 /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /opt/node-tiles
COPY scripts/node-tiles/ ./
RUN chmod +x build.sh

# Batch job runs as an arbitrary non-root uid; keep all scratch under /tmp.
ENV HOME=/tmp \
	WORKDIR=/tmp/node-tiles
ENTRYPOINT ["./build.sh"]
