# routess self-host environment template.
# Copy to the repo root as .env and replace placeholder values.
#
# Usage (run from the repository root):
#   cp docker/.env.selfhost.example .env
#   docker compose -f docker/compose.selfhost.yaml --project-directory . up -d

# --- Required ---

# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Long random string. Generate with: openssl rand -base64 32
ANALYTICS_SALT=change-me-to-a-long-random-analytics-salt
# Long random string. Generate with: openssl rand -base64 32
# Rotating this invalidates every existing personal access token.
PAT_PEPPER=change-me-to-a-long-random-pat-pepper

# Long random string for the Postgres user.
DB_PASSWORD=change-me-to-a-long-random-db-password

# Google OAuth (only login provider supported today).
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Mapbox access token (free tier is fine).
# Create at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token-here
VITE_ENABLE_NODE_NETWORK_OVERLAYS=false

# --- Public URLs (set when fronting with a reverse proxy / domain) ---

# Where users open the app. Used as OAuth redirect base.
PUBLIC_WEB_URL=http://localhost:8080
# Where the web app reaches the API. Use a public URL when behind a proxy.
PUBLIC_API_URL=http://localhost:3000

# --- Ports exposed on the host ---

WEB_PORT=8080
API_PORT=3000
DOCS_PORT=3002

# --- Database ---

DB_USER=routess
DB_NAME=routess

# --- Image tag ---

# Pin to a specific release in production. `latest` is fine for trying things out.
ROUTESS_TAG=latest

# --- Admin (optional) ---

# Comma-separated emails granted admin role on login. Empty = no admins.
ADMIN_EMAILS=

# --- Email (optional, leave empty to log verification URLs to API stdout) ---

RESEND_API_KEY=
EMAIL_FROM=routess <noreply@routess.app>

# --- Stadia Maps (optional, for surface analysis) ---

VITE_STADIA_API_KEY=

# --- Umami product analytics (optional, leave empty to disable) ---

VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=

# --- Sentry / GlitchTip error reporting (optional, leave empty to disable) ---

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
