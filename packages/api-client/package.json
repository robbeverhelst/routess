{
	"name": "@routess/api-client",
	"version": "0.1.0",
	"description": "Platform-agnostic API client for Routess with web and mobile adapters",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -b --force ../core tsconfig.json",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"lint": "biome check ."
	},
	"dependencies": {
		"@routess/core": "workspace:*"
	},
	"devDependencies": {
		"typescript": "~5.9.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./web": {
			"types": "./dist/adapters/web.d.ts",
			"default": "./dist/adapters/web.js"
		},
		"./mobile": {
			"types": "./dist/adapters/mobile.d.ts",
			"default": "./dist/adapters/mobile.js"
		}
	}
}
